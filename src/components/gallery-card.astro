---
import Link from '@/components/link.astro'
import type { Album } from '@/lib/albums'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'

interface Props {
  album: Album
}

const { album } = Astro.props
---

<div
  class="not-prose group border-foreground bg-card text-foreground hover:bg-secondary/50 h-full border transition-colors duration-300 ease-in-out"
>
  <Link href={`/gallery/${album.name}`} class="flex h-full flex-col">
    <div class="h-48 w-full overflow-hidden">
      <Image
        src={album.cover}
        alt={album.coverAlt}
        quality="high"
        width={768}
        height={480}
        fit="cover"
        position="center"
        sizes="(min-width: 1024px) 376px, (min-width: 768px) 768px, 100vw"
        class="h-full! w-full object-cover object-center transition-opacity group-hover:opacity-90"
      />
    </div>
    <div class="border-foreground flex-1 border-t p-2">
      <div class="mb-2 flex flex-wrap items-center justify-between gap-x-2">
        <h2 class="text-xl font-medium capitalize">
          {album.name}
        </h2>
        <p class="flex gap-x-1.5 px-1 text-sm">
          <span class="flex items-center gap-x-1.5">
            <Icon name="lucide:calendar" class="size-4" />
            <span>{formatDate(album.pubDate)}</span>
          </span>
        </p>
      </div>
      <p class="mt-4 mb-2 text-sm">
        {album.count} photo{album.count !== 1 ? 's' : ''}
      </p>
    </div>
  </Link>
</div>
